from dash import Dash, html, dcc, Input, Output, State, callback
from google.cloud import vision
import base64
import os
import dash_bootstrap_components as dbc
import pandas as pd
from datetime import datetime

# Set the environment variable for Google Application Credentials
os.environ['GOOGLE_APPLICATION_CREDENTIALS'] = ''

# Initialize the Dash app
app = Dash(__name__, external_stylesheets=[dbc.themes.BOOTSTRAP])

# Global variable to store results
scan_results = []


def get_text_blocks(response):
    """Extract text while preserving block structure and identifying names"""
    blocks = []
    names = []

    for page in response.full_text_annotation.pages:
        for block in page.blocks:
            block_text = ""
            for paragraph in block.paragraphs:
                para_text = ""
                for word in paragraph.words:
                    word_text = ''.join([symbol.text for symbol in word.symbols])
                    para_text += word_text + ' '
                block_text += para_text.strip() + '\n'

            if block_text.strip():
                block_text = block_text.strip()
                blocks.append(block_text)

                # Process names
                # Split into lines to handle each potential name separately
                lines = block_text.split('\n')
                for line in lines:
                    # Skip lines containing "PRINTED NAME"
                    if "PRINTED NAME" not in line.upper():
                        # Clean and validate potential name
                        cleaned_line = line.strip()
                        # Check if line looks like a name (contains letters and spaces)
                        if cleaned_line and any(c.isalpha() for c in cleaned_line):
                            names.append(cleaned_line)

    # Clean up names list - remove duplicates and empty strings
    names = [name for name in names if name.strip()]
    names = list(dict.fromkeys(names))  # Remove duplicates while preserving order

    return blocks, names


# Create the layout
app.layout = dbc.Container([
