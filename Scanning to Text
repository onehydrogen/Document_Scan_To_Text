], fluid=True)


def process_image(contents, filename):
    """Process a single image with Google Vision API"""
    try:
        client = vision.ImageAnnotatorClient()

        content = contents.split(',')[1]
        image_bytes = base64.b64decode(content)

        image = vision.Image(content=image_bytes)

        response = client.document_text_detection(image=image)

        if response.error.message:
            return {
                'filename': filename,
                'success': False,
                'error': response.error.message
            }

        text_blocks, names = get_text_blocks(response)

        # Debug print to console
        print(f"Found names in {filename}:", names)

        return {
            'filename': filename,
            'success': True,
            'blocks': text_blocks,
            'names': names
        }

    except Exception as e:
        return {
            'filename': filename,
            'success': False,
            'error': str(e)
        }


@app.callback(
    [Output('processing-status', 'children'),
     Output('results-container', 'children')],
    Input('upload-images', 'contents'),
    State('upload-images', 'filename')
)
def update_output(list_of_contents, list_of_names):
    if list_of_contents is None:
        return '', ''

    global scan_results
    scan_results = []

    for content, name in zip(list_of_contents, list_of_names):
        result = process_image(content, name)
        scan_results.append(result)

    status = f"Processed {len(scan_results)} files"

    results_display = []
    for result in scan_results:
        if result['success']:
            card = dbc.Card([
                dbc.CardHeader(result['filename']),
                dbc.CardBody([
                    html.H5("Names Found:", className="mb-2"),
                    html.P(', '.join(result['names']) if result['names'] else 'No names found',
                           className="text-primary mb-4"),
                    html.H5("Text Blocks:", className="mb-2"),
                    *[html.Div(block, className="p-3 mb-2 bg-light border rounded",
                               style={'white-space': 'pre-wrap'}) for block in result['blocks']]
                ])
            ], className="mb-3")
        else:
            card = dbc.Card([
                dbc.CardHeader(f"Error processing {result['filename']}"),
                dbc.CardBody([
                    html.P(f"Error: {result['error']}", className="text-danger")
                ])
            ], className="mb-3")
        results_display.append(card)

    return status, results_display


@app.callback(
    Output("download-dataframe-csv", "data"),
    Input("export-button", "n_clicks"),
    prevent_initial_call=True,
)
def export_csv(n_clicks):
    if not scan_results:
        return None

    # Print debug information
    print("Preparing CSV export...")
    for result in scan_results:
        if result['success']:
            print(f"File: {result['filename']}")
            print(f"Names found: {result['names']}")

    data = []
    for result in scan_results:
        if result['success']:
            # Create a new row for each name found
            for name in result['names']:
                data.append({
                    'File Name': result['filename'],
                    'Name': name,
                    'Status': 'Success'
                })
            # If no names found, still include the file
            if not result['names']:
                data.append({
                    'File Name': result['filename'],
                    'Name': '',
                    'Status': 'No names found'
                })
        else:
            data.append({
                'File Name': result['filename'],
                'Name': '',
                'Status': f"Error: {result['error']}"
            })

    df = pd.DataFrame(data)

    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    return dcc.send_data_frame(
        df.to_csv,
        f"scan_results_{timestamp}.csv",
        index=False
    )


if __name__ == '__main__':
    app.run(debug=True)
